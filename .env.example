# offline = deterministic routing and answers, no API key needed (default, used by tests and CI)
# anthropic = Claude routes intents and writes the final reply (grounding-checked)
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Leave empty to run MCP servers in-process. Set to use remote servers over streamable HTTP.
CATALOG_MCP_URL=
ORDERS_MCP_URL=
SUPPORT_MCP_URL=

RAG_TOP_K=3
RAG_MIN_SCORE=0.08
DEFAULT_CITY=Bengaluru
